{
  "name": "vectrace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky ; svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npmrun test:e2e",
    "test:e2e": "playwright install && playwright test",
    "flc": "npm run format ; npm run lint && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "esm-potrace-wasm": "^0.5.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "cookie": "^1.0.2"
  },
  "lint-staged": {
    "*.{js,ts,svelte,css,json,md}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.rs": [
      "mise exec -- rustfmt --edition 2024"
    ]
  },
  "license": "GPL-2.0-or-later",
  "description": "Convert raster images to SVG entirely in your browser. No server, no upload.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruckc/vectrace.git"
  },
  "dependencies": {
    "@ruckc/truss-ui": "^1.7.0"
  }
}
